{
  "name": "@invilite/framework",
  "version": "0.3.0",
  "description": "A TypeScript framework for Express servers with decorators, PostgreSQL repositories, sessions, background tasks and storage adapters.",
  "license": "GPL-3.0",
  "author": "Marek Ulwański <marek@ulwanski.pl>",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Invilite/framework.git"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf build dist coverage",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/stage-package.js",
    "pack:local": "npm run build && mkdir -p dist && npm pack ./build --pack-destination ./dist",
    "prepublishOnly": "node -e \"console.error('Publish from build/: npm run build && npm publish ./build'); process.exit(1)\"",
    "test": "jest"
  },
  "dependencies": {
    "@types/compression": "^1.7.5",
