    "nanoid": "^3.3.7",
    "serve-static": "^2.2.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@invilite/eventbus": "^1.1.0",
    "@invilite/logger": "^1.1.1",
    "@sentry/node": "^11.9.0",
    "amqplib": "^2.0.1",
    "aws4fetch": "^1.0.20",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "nats": "^2.29.3",
    "openai": "^6.10.0",
    "pg": "^8.16.3",
